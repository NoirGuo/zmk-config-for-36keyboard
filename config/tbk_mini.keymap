#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E            &kp R           &kp T        &kp Y        &kp U          &kp I       &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D            &kp F           &kp G        &kp H        &kp J          &kp K       &kp L    &kp SEMI  &lt 3 ENTER
&kp LSHFT  &kp Z  &kp X  &kp C            &kp V           &kp B        &kp N        &kp M          &kp COMMA   &kp DOT  &kp FSLH  &kp RSHFT
                         &mt LCTRL MINUS  &mt LGUI EQUAL  &lt 2 SPACE  &lt 1 SPACE  &mt RALT LBKT  &lt 2 RBKT
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &trans   &trans  &trans  &kp BSLH
&kp CAPS   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &trans   &trans  &trans  &kp APOS
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans
                           &trans  &trans  &trans  &trans  &trans  &kp DEL
            >;

            label = "NUM";
        };

        layer_2 {
            bindings = <
&trans  &trans      &trans        &kp PG_UP     &trans   &trans  &trans  &trans    &kp UP    &trans     &trans  &trans
&trans  &trans      &kp HOME      &kp PG_DN     &kp END  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans   &trans  &trans  &trans    &trans    &trans     &trans  &trans
                                  &trans        &trans   &trans  &trans  &trans    &trans
            >;

            label = "NAVI";
        };

        layer_3 {
            bindings = <
&studio_unlock  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5        &trans           &trans           &trans           &trans           &trans           &trans
&trans          &kp F6   &kp F7   &kp F8        &kp F9        &kp F10       &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &trans
&trans          &kp F11  &kp F12  &trans        &trans        &trans        &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &rgb_ug RGB_TOG
                                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans           &bt BT_CLR       &out OUT_TOG
            >;

            label = "CONF";
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
