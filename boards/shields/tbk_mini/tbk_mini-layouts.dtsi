            , <&key_physical_attrs 100 100 1200  250       0  1200   250>
            , <&key_physical_attrs 100 100 1300  250       0  1300   250>
            , <&key_physical_attrs 100 100  400  330    2000   400   330>
            , <&key_physical_attrs 100 100  500  360    2000   500   360>
            , <&key_physical_attrs 100 100  600  390    2000   600   390>
            , <&key_physical_attrs 100 100  705  425   34000   705   425>
            , <&key_physical_attrs 100 100  805  395   34000   805   395>
