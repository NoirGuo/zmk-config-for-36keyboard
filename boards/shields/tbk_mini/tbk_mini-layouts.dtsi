            , <&key_physical_attrs 100 100  800   25       0   800    25>
            , <&key_physical_attrs 100 100  900   25       0   900    25>
            , <&key_physical_attrs 100 100 1000    0       0  1000     0>
            , <&key_physical_attrs 100 100 1100   25       0  1100    25>
            , <&key_physical_attrs 100 100 1200   50       0  1200    50>
            , <&key_physical_attrs 100 100 1300   50       0  1300    50>
            , <&key_physical_attrs 100 100    0  150       0     0   150>
            , <&key_physical_attrs 100 100  100  150       0   100   150>
            , <&key_physical_attrs 100 100  200  125       0   200   125>
            , <&key_physical_attrs 100 100  300  100       0   300   100>
            , <&key_physical_attrs 100 100  400  125       0   400   125>
            , <&key_physical_attrs 100 100  500  125       0   500   125>
            , <&key_physical_attrs 100 100  800  125       0   800   125>
            , <&key_physical_attrs 100 100  900  125       0   900   125>
            , <&key_physical_attrs 100 100 1000  100       0  1000   100>
            , <&key_physical_attrs 100 100 1100  125       0  1100   125>
            , <&key_physical_attrs 100 100 1200  150       0  1200   150>
            , <&key_physical_attrs 100 100 1300  150       0  1300   150>
            , <&key_physical_attrs 100 100    0  250       0     0   250>
            , <&key_physical_attrs 100 100  100  250       0   100   250>
            , <&key_physical_attrs 100 100  200  225       0   200   225>
            , <&key_physical_attrs 100 100  300  200       0   300   200>
            , <&key_physical_attrs 100 100  400  225       0   400   225>
            , <&key_physical_attrs 100 100  500  225       0   500   225>
            , <&key_physical_attrs 100 100  800  225       0   800   225>
