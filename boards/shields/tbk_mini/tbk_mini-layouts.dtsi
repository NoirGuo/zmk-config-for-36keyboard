#include <physical_layouts.dtsi>

/ {
    physical_layout_tbk_mini: physical_layout_tbk_mini {
        compatible = "zmk,physical-layout";
        display-name = "TBK-mini";
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   50       0     0    50>
            , <&key_physical_attrs 100 100  100   50       0   100    50>
            , <&key_physical_attrs 100 100  200   25       0   200    25>
            , <&key_physical_attrs 100 100  300    0       0   300     0>
